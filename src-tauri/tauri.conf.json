{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Real Denim Fit",
  "mainBinaryName": "Real Denim Fit",
  "version": "0.5.0",
  "identifier": "io.github.digitaln.realdenimfit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Real Denim Fit",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Lifestyle",
    "shortDescription": "Raw denim jeans that fit, from your measurements",
    "copyright": "GPL-3.0",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRUMzMzM1OUQxMkQyRjcKUldUMzBoS2ROVFBzVXNSWnl6WUt0VTRqMHFZM0dHVzQ1MzFJUVZkbzJaMHZqUnlLU3oyRERzeXcK",
      "endpoints": [
        "https://github.com/DigitalN/Real-Denim-Fit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
